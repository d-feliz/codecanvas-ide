	"tokenColors": [
		{
			"name": "Code",
			"scope": [
				"source",
				"variable",
				"meta.embedded",
				"punctuation"
			],
			"settings": {
				"foreground": "#C9CCD2"
			}
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#7D828C"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"variable.language"
			],
			"settings": {
				"foreground": "#C3A6F0"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#9FD3EC"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.tag",
				"meta.type.annotation"
			],
			"settings": {
				"foreground": "#B8C4FF"
			}
		},
		{
			"name": "Constants and numbers",
			"scope": [
				"constant",
				"constant.numeric",
				"constant.language",
				"variable.other.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#7CC4E8"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#F2F2F3"
			}
		},
		{
			"name": "Attributes and properties",
			"scope": [
				"entity.other.attribute-name",
				"variable.other.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#A9ADB6"
			}
		},
		{
			"name": "Markdown headings",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#F2F2F3",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#F2877D"
			}
		},
		{
			"name": "JSON keys",
			"scope": [
				"support.type.property-name.json",
				"punctuation.support.type.property-name.begin.json",
				"punctuation.support.type.property-name.end.json"
			],
			"settings": {
				"foreground": "#C9CCD2"
			}
		},
		{
			"name": "JSON strings",
			"scope": [
				"string.quoted.double.json",
				"string.quoted.double.json punctuation.definition.string"
			],
			"settings": {
				"foreground": "#9FD3EC"
			}
		},
		{
			"name": "JSON numbers",
			"scope": [
				"constant.numeric.json"
			],
			"settings": {
				"foreground": "#E8B04A"
			}
		},
		{
			"name": "JSON booleans",
			"scope": [
				"constant.language.json"
			],
			"settings": {
				"foreground": "#A98BF0"
			}
		},
		{
			"name": "JSON punctuation",
			"scope": [
				"punctuation.definition.dictionary.begin.json",
				"punctuation.definition.dictionary.end.json",
				"punctuation.definition.array.begin.json",
				"punctuation.definition.array.end.json",
				"punctuation.separator.dictionary.key-value.json",
				"punctuation.separator.dictionary.pair.json",
				"punctuation.separator.array.json"
			],
			"settings": {
				"foreground": "#6E727B"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#F2F2F3",
		"method": "#F2F2F3",
		"type": "#B8C4FF",
		"class": "#B8C4FF",
		"interface": "#B8C4FF",
		"enum": "#B8C4FF",
		"variable.readonly": "#7CC4E8",
		"enumMember": "#7CC4E8",
		"property": "#A9ADB6",
		"parameter": "#C9CCD2"
	}
}
