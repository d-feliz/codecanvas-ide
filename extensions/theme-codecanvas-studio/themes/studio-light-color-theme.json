	"tokenColors": [
		{
			"name": "Code",
			"scope": [
				"source",
				"variable",
				"meta.embedded",
				"punctuation"
			],
			"settings": {
				"foreground": "#2E3036"
			}
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6F737B"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"variable.language"
			],
			"settings": {
				"foreground": "#7A3FC0"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#1D6A92"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.tag",
				"meta.type.annotation"
			],
			"settings": {
				"foreground": "#3B4FB0"
			}
		},
		{
			"name": "Constants and numbers",
			"scope": [
				"constant",
				"constant.numeric",
				"constant.language",
				"variable.other.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#1D6A92"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#0F1012"
			}
		},
		{
			"name": "Attributes and properties",
			"scope": [
				"entity.other.attribute-name",
				"variable.other.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#4A4D55"
			}
		},
		{
			"name": "Markdown headings",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#0F1012",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#B4362B"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#0F1012",
		"method": "#0F1012",
		"type": "#3B4FB0",
		"class": "#3B4FB0",
		"interface": "#3B4FB0",
		"enum": "#3B4FB0",
		"variable.readonly": "#1D6A92",
		"enumMember": "#1D6A92",
		"property": "#4A4D55",
		"parameter": "#2E3036"
	}
}
